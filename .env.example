# MessV2 Environment Configuration
# Copy this file to .env and fill in your values

# ===================
# Application
# ===================
APP_ENV=development
DEBUG_MODE=true
APP_URL=http://localhost/messv2

# ===================
# Facebook App
# ===================
FACEBOOK_APP_ID=your_app_id_here
FACEBOOK_APP_SECRET=your_app_secret_here
WEBHOOK_VERIFY_TOKEN=messv2_verify_token_change_this

# ===================
# Database
# ===================
DB_DRIVER=sqlite
DB_PATH=storage/database/app.db

# ===================
# AI/LLM Configuration
# ===================
AI_ENABLED=true
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-3.5-turbo

# ===================
# n8n Integration
# ===================
N8N_ENABLED=false
N8N_WEBHOOK_URL=http://localhost:5678/webhook/messv2
N8N_API_KEY=

# ===================
# Security
# ===================
SESSION_SECRET=change_this_to_random_string
ENCRYPT_TOKENS=true
