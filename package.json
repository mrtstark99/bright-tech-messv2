{
    "name": "messv2-fanpage-manager",
    "version": "1.0.0",
    "description": "Modern SaaS Fanpage Manager with clean architecture",
    "scripts": {
        "dev": "npx tailwindcss -i ./resources/css/app.css -o ./public/build/app.css --watch",
        "build": "npx tailwindcss -i ./resources/css/app.css -o ./public/build/app.css --minify",
        "build:js": "esbuild resources/js/app.js --bundle --outfile=public/build/app.js --minify"
    },
    "keywords": [
        "fanpage",
        "messenger",
        "facebook",
        "saas",
        "admin"
    ],
    "author": "Bright Tech",
    "license": "MIT",
    "devDependencies": {
        "tailwindcss": "^3.4.1",
        "autoprefixer": "^10.4.17",
        "postcss": "^8.4.35"
    }
}